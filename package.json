{
  "name": "tom-and-grace",
  "version": "1.4.0",
  "private": true,
  "description": "A multiplayer 3D social world with penthouse, city, cars, proximity voice, room chat, sleep and dance activities, synchronized YouTube, and Spotify embeds.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test:smoke": "node server-smoke-test.js",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.tomandgrace.game",
    "productName": "Tom&Grace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TomAndGrace-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tom&Grace"
    }
  }
}
